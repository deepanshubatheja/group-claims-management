{
  "name": "@group-claims/electron",
  "version": "0.1.2-beta",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test test-dist/tests/*.test.js",
    "dev:build": "tsc -p tsconfig.json --watch",
    "dev:start": "wait-on http-get://127.0.0.1:5173/ file:dist/main.js file:dist/preload.js && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 nodemon --watch dist --ext js --exec electron ."
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "cross-env": "7.0.3",
    "electron": "35.2.0",
    "nodemon": "3.1.10",
    "typescript": "5.8.3",
    "wait-on": "8.0.3"
  }
}
